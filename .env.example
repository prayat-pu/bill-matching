# Server-side only. Never ship this key to the browser.
GEMINI_API_KEY=
# Optional. Default: gemini-3.8-flash (reads handwritten times more reliably
# than gemini-3.1-flash-lite, which is about half the cost).
# GEMINI_MODEL=gemini-3.8-flash
# Optional. Most receipt PDFs one run accepts. Default: 50. Every file is held
# in memory while the run works, so raise it only as far as the machine's RAM allows.
# MAX_RECEIPTS=50
